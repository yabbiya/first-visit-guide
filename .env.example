# 이 파일을 복사해서 이름을 .env 로 바꾸고, = 뒤에 인증키를 붙여넣으세요.
# .env 파일은 비밀 파일이라 깃허브에 올라가지 않아요(.gitignore 에 등록됨).
# 공공데이터포털 > 마이페이지 > 활용신청 현황 > 일반 인증키(Decoding)
KMA_SERVICE_KEY=

# $3 평생 이용권 (Lemon Squeezy). 비밀 값은 아니지만, 남의 상품 키를 걸러내는 데 쓰므로 Vercel 환경변수에도 꼭 넣는다.
# Lemon Squeezy > Settings > Stores 의 Store ID, Products 에서 상품을 열었을 때의 Product ID
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRODUCT_ID=
